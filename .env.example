# PostgreSQL-compatible database. Neon, Railway, Render và self-hosted Postgres đều dùng được.

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Bắt buộc khi production. Tạo bằng: openssl rand -base64 32

SESSION_SECRET=replace-with-a-long-random-value

# Origin (domain) được phép gửi request kèm cookie. Nếu deploy cùng domain thì để trống.

APP_ORIGIN=

# Thư mục lưu ảnh upload cho hosting Node truyền thống.

# Với hosting serverless, thay adapter trong api-server/src/routes/uploads.ts

# bằng S3-compatible storage trước khi deploy.

UPLOAD_DIR=uploads

# Đặt là production trên server đã deploy.

NODE_ENV=development

# — Bộ lọc ảnh nhạy cảm (Hugging Face) —

# Lấy API key miễn phí tại https://huggingface.co/settings/tokens (chọn quyền “Read”).

HUGGINGFACE_API_KEY=

# true = bật lọc, false = tắt hẳn (không gọi Hugging Face).

# Nếu HUGGINGFACE_API_KEY để trống thì coi như tự động tắt dù giá trị này là gì.

NSFW_FILTER_ENABLED=true

# Model phân loại: neutral, drawings, sexy, hentai, porn.

NSFW_MODEL=giacomoarienti/nsfw-classifier

# Nhãn nào bị chặn (phân cách bằng dấu phẩy). Mặc định chỉ chặn khoả thân thật/vẽ 18+.

# “sexy” (bikini/nội y/đồ hở) và “neutral” KHÔNG nằm trong danh sách này nên vẫn được phép.

NSFW_BLOCKED_LABELS=porn,hentai

# Độ tin cậy tối thiểu (0-1) để coi ảnh là vi phạm.

NSFW_BLOCK_THRESHOLD=0.6

# true = nếu Hugging Face lỗi/timeout thì vẫn cho ảnh qua (không chặn tính năng đặt tranh).

# false = nếu không kiểm duyệt được thì chặn luôn ảnh đó.

NSFW_FAIL_OPEN=true
