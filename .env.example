# PostgreSQL-compatible database. Neon, Railway, Render va self-hosted Postgres deu dung duoc.

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Bat buoc khi production. Tao bang: openssl rand -base64 32

SESSION_SECRET=replace-with-a-long-random-value

# Origin (domain) duoc phep gui request kem cookie. Neu deploy cung domain thi de trong.

APP_ORIGIN=

# Dat la production tren server da deploy.

NODE_ENV=development

# — Luu anh upload (Cloudflare R2, tuong thich S3) —

# Tao bucket tai https://dash.cloudflare.com -> R2 -> Create bucket

# Tao API token tai R2 -> Manage R2 API Tokens -> Create API Token (quyen Object Read & Write)

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# — Bo loc anh nhay cam (Hugging Face) —

# Lay API key mien phi tai https://huggingface.co/settings/tokens (chon quyen “Read”).

HUGGINGFACE_API_KEY=

# true = bat loc, false = tat han (khong goi Hugging Face).

# Neu HUGGINGFACE_API_KEY de trong thi coi nhu tu dong tat du gia tri nay la gi.

NSFW_FILTER_ENABLED=true

# Model phan loai: neutral, drawings, sexy, hentai, porn.

NSFW_MODEL=giacomoarienti/nsfw-classifier

# Nhan nao bi chan (phan cach bang dau phay). Mac dinh chi chan khoa than that/ve 18+.

# “sexy” (bikini/noi y/do ho) va “neutral” KHONG nam trong danh sach nay nen van duoc phep.

NSFW_BLOCKED_LABELS=porn,hentai

# Do tin cay toi thieu (0-1) de coi anh la vi pham.

NSFW_BLOCK_THRESHOLD=0.6

# true = neu Hugging Face loi/timeout thi van cho anh qua (khong chan tinh nang dat tranh).

# false = neu khong kiem duyet duoc thi chan luon anh do.

NSFW_FAIL_OPEN=true
